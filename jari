<title>스마트 자리 배치</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #F4F6F3;
    --surface: #FFFFFF;
    --surface-2: #EDF1EC;
    --border: #DBE3DA;
    --ink: #1F2A24;
    --ink-soft: #5C6B62;
    --ink-faint: #8B978F;
    --accent: #2F6E52;
    --accent-deep: #1F5039;
    --accent-soft: #DCEAE1;
    --warn: #B23A2E;
    --warn-soft: #F6DEDB;
    --gold: #B8862E;
    --shadow: 150 20% 12%;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg: #161A17;
      --surface: #1E2420;
      --surface-2: #232B26;
      --border: #34403A;
      --ink: #E9EEE9;
      --ink-soft: #A3B0A8;
      --ink-faint: #71807A;
      --accent: #58A583;
      --accent-deep: #7CC2A0;
      --accent-soft: #26382E;
      --warn: #E2695C;
      --warn-soft: #3A2422;
      --gold: #D2A857;
      --shadow: 150 40% 2%;
    }
  }
  :root[data-theme="dark"]{
    --bg: #161A17;
    --surface: #1E2420;
    --surface-2: #232B26;
    --border: #34403A;
    --ink: #E9EEE9;
    --ink-soft: #A3B0A8;
    --ink-faint: #71807A;
    --accent: #58A583;
    --accent-deep: #7CC2A0;
    --accent-soft: #26382E;
    --warn: #E2695C;
    --warn-soft: #3A2422;
    --gold: #D2A857;
    --shadow: 150 40% 2%;
  }

  *{ box-sizing:border-box; }
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font-family:"Noto Sans KR","Malgun Gothic",sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{ margin:0; text-wrap:balance; font-family:"IBM Plex Sans KR","Noto Sans KR",sans-serif; }
  button{ font-family:inherit; }
  :focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
  input, select, textarea{ font-family:inherit; }

  .app{ max-width:1320px; margin:0 auto; padding:20px 22px 60px; }

  /* top bar */
  .topbar{
    display:flex; align-items:center; gap:14px; flex-wrap:wrap;
    padding-bottom:14px; margin-bottom:16px; border-bottom:1px solid var(--border);
  }
  .brand{ font-size:19px; font-weight:700; white-space:nowrap; }
  .class-tabs{ display:flex; gap:6px; flex-wrap:wrap; flex:1; }
  .class-tab{
    display:flex; align-items:center; gap:6px;
    border:1px solid var(--border); background:var(--surface);
    color:var(--ink-soft); border-radius:8px; padding:6px 10px; font-size:13px; cursor:pointer;
  }
  .class-tab.active{ border-color:var(--accent); background:var(--accent-soft); color:var(--ink); font-weight:600; }
  .class-tab .rn{ border:none; background:none; color:inherit; font-size:12px; padding:0; cursor:pointer; opacity:.6; }
  .class-tab .rn:hover{ opacity:1; }
  .icon-btn{
    border:1px solid var(--border); background:var(--surface); color:var(--ink-soft);
    border-radius:8px; padding:6px 11px; font-size:13px; cursor:pointer; white-space:nowrap;
  }
  .icon-btn:hover{ border-color:var(--accent); color:var(--ink); }
  .topbar-actions{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .ghost.danger{ color:var(--warn); }
  .ghost.danger.armed{ background:var(--warn-soft); border-color:var(--warn); }

  /* layout */
  .layout{ display:grid; grid-template-columns:300px 1fr; gap:18px; align-items:start; }
  @media (max-width:900px){ .layout{ grid-template-columns:1fr; } }

  .sidebar{ background:var(--surface); border:1px solid var(--border); border-radius:12px; overflow:hidden; }
  .tabs{ display:flex; border-bottom:1px solid var(--border); }
  .tab-btn{
    flex:1; border:none; background:var(--surface-2); color:var(--ink-soft);
    padding:10px 6px; font-size:12.5px; font-weight:600; cursor:pointer; border-right:1px solid var(--border);
  }
  .tab-btn:last-child{ border-right:none; }
  .tab-btn.active{ background:var(--surface); color:var(--accent-deep); box-shadow:inset 0 -2px 0 var(--accent); }
  .tab-panel{ display:none; padding:16px; }
  .tab-panel.active{ display:block; }
  .tab-panel h3{ font-size:12px; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:10px; }
  .tab-panel section + section{ margin-top:20px; padding-top:16px; border-top:1px solid var(--border); }

  .row{ display:flex; gap:6px; }
  .row input[type=text]{
    flex:1; min-width:0; border:1px solid var(--border); background:var(--bg); color:var(--ink);
    border-radius:8px; padding:8px 10px; font-size:13.5px;
  }
  .row button{
    border:1px solid var(--border); background:var(--accent); color:#fff;
    border-radius:8px; padding:8px 12px; font-size:12.5px; font-weight:600; cursor:pointer; white-space:nowrap;
  }
  textarea.bulk{
    width:100%; min-height:52px; resize:vertical; border:1px dashed var(--border); background:transparent;
    color:var(--ink-soft); border-radius:8px; padding:8px 10px; font-size:12px; margin-top:6px;
  }
  .bulk-actions{ display:flex; justify-content:flex-end; margin-top:5px; }
  .bulk-actions button{ border:none; background:none; color:var(--accent-deep); font-size:12px; font-weight:600; cursor:pointer; }

  .sample-note{ font-size:11px; color:var(--ink-faint); margin:10px 0 0; padding-top:10px; border-top:1px dashed var(--border); }

  .student-list{ display:flex; flex-direction:column; gap:6px; max-height:280px; overflow-y:auto; margin-top:10px; }
  .student-row{ border:1px solid var(--border); border-radius:8px; padding:7px 9px; background:var(--bg); }
  .student-row .name-line{ display:flex; align-items:center; justify-content:space-between; gap:6px; }
  .student-row .name-line span{ font-size:13.5px; font-weight:600; }
  .student-row .del{ border:none; background:none; color:var(--ink-faint); cursor:pointer; font-size:14px; padding:0 3px; }
  .student-row .del:hover{ color:var(--warn); }
  .need-toggles{ display:flex; gap:10px; margin-top:5px; flex-wrap:wrap; }
  .need-toggles label{ display:flex; align-items:center; gap:3px; font-size:11px; color:var(--ink-soft); cursor:pointer; }
  .empty-hint{ color:var(--ink-faint); font-size:12.5px; padding:6px 2px; }

  select{ border:1px solid var(--border); background:var(--bg); color:var(--ink); border-radius:8px; padding:7px 8px; font-size:12.5px; }
  .rule-add{ display:flex; flex-direction:column; gap:6px; }
  .rule-add .pair{ display:flex; gap:6px; }
  .rule-add select{ flex:1; min-width:0; }
  .rule-add input[type=text]{ border:1px solid var(--border); background:var(--bg); color:var(--ink); border-radius:8px; padding:7px 8px; font-size:12px; }
  .rule-list{ display:flex; flex-direction:column; gap:6px; margin-top:10px; }
  .rule-item{ border:1px solid var(--border); border-radius:8px; padding:7px 9px; background:var(--bg); font-size:12.5px; }
  .rule-item .pair-line{ display:flex; justify-content:space-between; align-items:center; gap:6px; }
  .rule-item .note{ color:var(--ink-faint); font-size:11px; margin-top:3px; }
  .rule-item .del{ border:none; background:none; color:var(--ink-faint); cursor:pointer; font-size:13px; }
  .rule-item .del:hover{ color:var(--warn); }
  .rule-item.hard{ border-left:3px solid var(--warn); }
  .rule-item.soft{ border-left:3px solid var(--accent); }

  .dims-row{ display:flex; gap:8px; align-items:center; }
  .dims-row input[type=number]{ width:56px; border:1px solid var(--border); background:var(--bg); color:var(--ink); border-radius:8px; padding:7px; font-size:13px; text-align:center; }
  .dims-row button{ border:1px solid var(--border); background:var(--accent); color:#fff; border-radius:8px; padding:7px 11px; font-size:12.5px; font-weight:600; cursor:pointer; }
  .desk-pos-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-top:8px; }
  .desk-pos-btn{ border:1px solid var(--border); background:var(--bg); color:var(--ink-soft); border-radius:8px; padding:7px 4px; font-size:11.5px; cursor:pointer; }
  .desk-pos-btn.active{ border-color:var(--accent); background:var(--accent-soft); color:var(--ink); font-weight:600; }
  .edit-toggle{ display:flex; align-items:center; gap:8px; margin-top:12px; font-size:12.5px; color:var(--ink-soft); }
  .hint-small{ font-size:11px; color:var(--ink-faint); margin-top:6px; }

  /* stage */
  .stage{ display:flex; flex-direction:column; gap:16px; }
  .toolbar{
    display:flex; align-items:center; gap:12px; flex-wrap:wrap;
    background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:12px 16px;
  }
  .primary-btn{
    border:none; background:var(--accent); color:#fff; font-weight:700; font-size:14px;
    padding:10px 20px; border-radius:999px; cursor:pointer;
  }
  .primary-btn:hover{ background:var(--accent-deep); }
  .primary-btn.secondary{ background:var(--surface-2); color:var(--ink); border:1px solid var(--border); }
  .primary-btn.secondary:hover{ border-color:var(--accent); }
  .primary-btn:disabled{ opacity:.45; cursor:not-allowed; }
  .toolbar-status{ font-size:12.5px; color:var(--ink-soft); }
  .toolbar-status.warn{ color:var(--warn); font-weight:600; }

  .tray-wrap{ background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:12px 16px; }
  .tray-wrap h3{ font-size:12px; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:8px; }
  .unseated-tray{ display:flex; flex-wrap:wrap; gap:8px; min-height:34px; }
  .tray-empty{ color:var(--ink-faint); font-size:12.5px; }

  .grid-wrap{
    background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:18px;
    display:flex; gap:12px; align-items:stretch;
  }
  .grid-wrap.dir-col{ flex-direction:column; }
  .grid-wrap.dir-col-rev{ flex-direction:column-reverse; }
  .grid-wrap.dir-row{ flex-direction:row; }
  .grid-wrap.dir-row-rev{ flex-direction:row-reverse; }
  .desk-bar{
    background:var(--surface-2); border:1px dashed var(--border); border-radius:8px;
    display:flex; align-items:center; justify-content:center; color:var(--ink-soft);
    font-size:12px; font-weight:600; letter-spacing:.03em; flex-shrink:0;
  }
  .dir-col .desk-bar, .dir-col-rev .desk-bar{ height:34px; }
  .dir-row .desk-bar, .dir-row-rev .desk-bar{ width:34px; writing-mode:vertical-rl; }

  .seat-grid{ display:grid; gap:8px; flex:1; }
  .seat{
    position:relative; min-height:58px; border-radius:9px; border:1.5px solid var(--border);
    background:var(--bg); display:flex; align-items:center; justify-content:center; padding:4px;
  }
  .seat.gap{ border:1px dashed var(--border); background:transparent; opacity:.35; }
  .seat.dragover{ border-color:var(--accent); background:var(--accent-soft); }
  .seat-tag{
    width:100%; height:100%; border-radius:7px; background:var(--surface); border:1.5px solid var(--border);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
    padding:4px 3px; cursor:pointer; user-select:none; position:relative;
  }
  .seat-tag.picked{ border-color:var(--accent); box-shadow:0 0 0 2px var(--accent-soft); }
  .seat-tag.violation{ border-color:var(--warn); background:var(--warn-soft); }
  .seat-tag .nm{ font-size:12.5px; font-weight:700; word-break:keep-all; text-align:center; line-height:1.2; }
  .seat-tag .badges{ display:flex; gap:2px; font-size:9.5px; }
  .seat-tag .pin{
    position:absolute; top:-6px; right:-6px; width:18px; height:18px; border-radius:50%;
    border:1px solid var(--border); background:var(--surface); font-size:9px; cursor:pointer;
    display:flex; align-items:center; justify-content:center; color:var(--ink-faint);
  }
  .seat-tag .pin.on{ background:var(--gold); color:#fff; border-color:var(--gold); }
  .seat-num{ font-size:10px; color:var(--ink-faint); }

  .tray-tag{
    border:1.5px solid var(--border); background:var(--surface); border-radius:8px;
    padding:6px 10px; font-size:12.5px; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:5px;
  }
  .tray-tag.picked{ border-color:var(--accent); box-shadow:0 0 0 2px var(--accent-soft); }
  .tray-tag .badges{ font-size:9.5px; display:flex; gap:2px; }

  .history-panel{ background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:14px 16px; }
  .history-panel h2{ font-size:13px; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:10px; }
  .history-list{ display:flex; flex-direction:column; gap:6px; max-height:220px; overflow-y:auto; }
  .history-empty{ color:var(--ink-faint); font-size:12.5px; }
  .history-item{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    border:1px solid var(--border); border-radius:8px; padding:8px 10px; font-size:12.5px; background:var(--bg);
  }
  .history-item .meta{ color:var(--ink-soft); }
  .history-item .acts{ display:flex; gap:6px; }
  .history-item button{ border:1px solid var(--border); background:var(--surface); color:var(--ink-soft); border-radius:6px; padding:4px 9px; font-size:11.5px; cursor:pointer; }
  .history-item button:hover{ border-color:var(--accent); color:var(--ink); }
  .history-item button.del:hover{ border-color:var(--warn); color:var(--warn); }
</style>

<div class="app">
  <header class="topbar">
    <div class="brand">스마트 자리 배치</div>
    <div class="class-tabs" id="class-tabs"></div>
    <button class="icon-btn" id="add-class-btn">+ 반 추가</button>
    <div class="topbar-actions">
      <button class="icon-btn" id="export-btn">내보내기</button>
      <button class="icon-btn" id="import-btn">불러오기</button>
      <input type="file" id="import-file" accept=".json" hidden />
      <button class="icon-btn danger" id="reset-class-btn">반 초기화</button>
    </div>
  </header>

  <div class="layout">
    <aside class="sidebar">
      <div class="tabs">
        <button class="tab-btn active" data-tab="students">학생 명단</button>
        <button class="tab-btn" data-tab="rules">배치 규칙</button>
        <button class="tab-btn" data-tab="layout">교실 설정</button>
      </div>

      <section class="tab-panel active" id="panel-students">
        <section>
          <h3>학생 추가</h3>
          <div class="row">
            <input type="text" id="student-input" placeholder="이름 입력 후 Enter" maxlength="20" />
            <button id="student-add-btn">추가</button>
          </div>
          <textarea class="bulk" id="student-bulk" placeholder="여러 명은 줄바꿈으로 구분해 붙여넣으세요"></textarea>
          <div class="bulk-actions"><button id="student-bulk-btn">일괄 추가</button></div>
          <p class="sample-note" id="sample-note">예시 학생 명단이에요. 자유롭게 수정하거나 전체 삭제 후 사용하세요.</p>
        </section>
        <section>
          <h3>명단 (<span id="student-count">0</span>명)</h3>
          <div class="student-list" id="student-list"></div>
        </section>
      </section>

      <section class="tab-panel" id="panel-rules">
        <section>
          <h3>분리해야 하는 학생 (강한 규칙)</h3>
          <div class="rule-add">
            <div class="pair">
              <select id="hard-a"></select>
              <select id="hard-b"></select>
            </div>
            <input type="text" id="hard-note" placeholder="사유 (선택, 규칙 목록에서만 보여요)" maxlength="40" />
            <button id="hard-add-btn" style="align-self:flex-end;">추가</button>
          </div>
          <div class="rule-list" id="hard-list"></div>
        </section>
        <section>
          <h3>가까이 앉히면 좋은 학생 (약한 규칙)</h3>
          <div class="rule-add">
            <div class="pair">
              <select id="soft-a"></select>
              <select id="soft-b"></select>
            </div>
            <button id="soft-add-btn" style="align-self:flex-end;">추가</button>
          </div>
          <div class="rule-list" id="soft-list"></div>
        </section>
      </section>

      <section class="tab-panel" id="panel-layout">
        <section>
          <h3>좌석 크기</h3>
          <div class="dims-row">
            행 <input type="number" id="rows-input" min="1" max="12" value="5" />
            열 <input type="number" id="cols-input" min="1" max="12" value="6" />
            <button id="dims-apply-btn">적용</button>
          </div>
        </section>
        <section>
          <h3>칠판 / 교탁 위치</h3>
          <div class="desk-pos-grid">
            <button class="desk-pos-btn" data-pos="top">위</button>
            <button class="desk-pos-btn" data-pos="bottom">아래</button>
            <button class="desk-pos-btn" data-pos="left">왼쪽</button>
            <button class="desk-pos-btn" data-pos="right">오른쪽</button>
          </div>
        </section>
        <section>
          <h3>빈 자리 / 통로 만들기</h3>
          <label class="edit-toggle"><input type="checkbox" id="edit-mode-toggle" /> 편집 모드 (칸을 눌러 통로로 만들기)</label>
          <p class="hint-small">편집 모드에서 좌석 칸을 클릭하면 통로(빈 공간)로 바뀌고, 다시 누르면 좌석으로 돌아와요.</p>
        </section>
      </section>
    </aside>

    <main class="stage">
      <div class="toolbar">
        <button class="primary-btn" id="auto-arrange-btn">자동 배치</button>
        <button class="primary-btn secondary" id="confirm-btn">확정</button>
        <span class="toolbar-status" id="toolbar-status"></span>
      </div>

      <div class="tray-wrap">
        <h3>미배치 학생</h3>
        <div class="unseated-tray" id="unseated-tray"></div>
      </div>

      <div class="grid-wrap" id="grid-wrap">
        <div class="desk-bar" id="desk-bar">칠판 / 교탁</div>
        <div class="seat-grid" id="seat-grid"></div>
      </div>

      <section class="history-panel">
        <h2>배치 기록</h2>
        <div class="history-list" id="history-list"></div>
      </section>
    </main>
  </div>
</div>

<script>
(function(){
  var STORAGE_KEY = "smart-seating-v1";
  var NEED_ICON = { front:"👁", back:"📏", aisle:"♿" };
  var DESK_LABEL = { top:"칠판 / 교탁 (위)", bottom:"칠판 / 교탁 (아래)", left:"칠판 / 교탁 (왼쪽)", right:"칠판 / 교탁 (오른쪽)" };

  function genId(prefix){ return prefix + Math.random().toString(36).slice(2,9) + Date.now().toString(36).slice(-4); }
  function seatId(r,c){ return r + "_" + c; }

  function makeDefaultClass(name){
    return {
      id: genId("c"), name: name,
      students: [], isSample: false,
      hardRules: [], softRules: [],
      layout: { rows:5, cols:6, deskPos:"top", gaps:[] },
      assignment: {}, history: []
    };
  }

  function makeSampleClass(){
    var cls = makeDefaultClass("1반");
    cls.isSample = true;
    var names = ["김하늘","이도윤","박서연","최민준","정지호","강예은","윤서준","한소율",
                 "임재현","오다인","조은우","신유나","문시우","배아린","송지안","황태윤"];
    cls.students = names.map(function(n, i){
      return { id: genId("s"), name:n, needsFront:false, needsBack:false, needsAisle:false, fixedSeatId:null };
    });
    cls.students[0].needsFront = true;   // 시력이 약한 학생 예시
    cls.students[1].needsBack = true;    // 키가 큰 학생 예시
    cls.students[2].needsAisle = true;   // 통로 자리가 필요한 학생 예시
    cls.hardRules = [{ a: cls.students[3].id, b: cls.students[4].id, note:"자주 다퉈서 분리 필요(예시)" }];
    cls.softRules = [{ a: cls.students[5].id, b: cls.students[6].id }];
    cls.layout = { rows:4, cols:5, deskPos:"top", gaps:[] };
    return cls;
  }

  var state = { classes:{}, currentClassId:null };
  try{
    var raw = localStorage.getItem(STORAGE_KEY);
    if(raw){
      var saved = JSON.parse(raw);
      if(saved && saved.classes && Object.keys(saved.classes).length){ state = saved; }
    }
  }catch(e){ /* ignore, fall back to fresh state below */ }

  if(!state.classes || !Object.keys(state.classes).length){
