  /* ---------- constraint helpers ---------- */
  function frontDistance(r,c,layout){
    if(layout.deskPos==="top") return r;
    if(layout.deskPos==="bottom") return (layout.rows-1-r);
    if(layout.deskPos==="left") return c;
    return (layout.cols-1-c); // right
  }
  function maxFrontDistance(layout){
    return (layout.deskPos==="top"||layout.deskPos==="bottom") ? Math.max(1,layout.rows-1) : Math.max(1,layout.cols-1);
  }
  function isGap(r,c,layout){ return layout.gaps.indexOf(seatId(r,c))>-1; }
  function isActiveSeat(r,c,layout){
    return r>=0 && r<layout.rows && c>=0 && c<layout.cols && !isGap(r,c,layout);
  }
  function isAisleAdjacent(r,c,layout){
    var neighbors = [[r-1,c],[r+1,c],[r,c-1],[r,c+1]];
    return neighbors.some(function(n){ return !isActiveSeat(n[0],n[1],layout); });
  }
  function activeSeatIds(layout){
    var ids=[];
    for(var r=0;r<layout.rows;r++) for(var c=0;c<layout.cols;c++){ if(!isGap(r,c,layout)) ids.push(seatId(r,c)); }
    return ids;
  }
  function adjacencyPairs(assignment, layout){
    var pairs=[];
    for(var r=0;r<layout.rows;r++){
      for(var c=0;c<layout.cols;c++){
        if(isGap(r,c,layout)) continue;
        var here = assignment[seatId(r,c)];
        if(!here) continue;
        [[r,c+1],[r+1,c]].forEach(function(n){
          if(isActiveSeat(n[0],n[1],layout)){
            var other = assignment[seatId(n[0],n[1])];
            if(other) pairs.push([here, other]);
          }
        });
      }
    }
    return pairs;
  }
  function pairKey(a,b){ return a<b ? a+"|"+b : b+"|"+a; }

  function currentViolations(){
    var cls = currentClass();
    var pairs = adjacencyPairs(cls.assignment, cls.layout);
    var hardSet = {};
    cls.hardRules.forEach(function(r){ hardSet[pairKey(r.a,r.b)]=true; });
    var bad = [];
    pairs.forEach(function(p){ var k=pairKey(p[0],p[1]); if(hardSet[k]) bad.push(p); });
    return bad;
  }

  /* ---------- render seat grid ---------- */
  function renderGrid(){
    var cls = currentClass();
    var layout = cls.layout;
    seatGridEl.style.gridTemplateColumns = "repeat(" + layout.cols + ", 1fr)";
    seatGridEl.style.gridTemplateRows = "repeat(" + layout.rows + ", 1fr)";
    seatGridEl.innerHTML = "";

    gridWrapEl.className = "grid-wrap " +
      (layout.deskPos==="top" ? "dir-col" : layout.deskPos==="bottom" ? "dir-col-rev" :
       layout.deskPos==="left" ? "dir-row" : "dir-row-rev");
    deskBarEl.textContent = DESK_LABEL[layout.deskPos];
    if(gridWrapEl.firstElementChild !== deskBarEl && (layout.deskPos==="bottom"||layout.deskPos==="right")){
      gridWrapEl.appendChild(deskBarEl); gridWrapEl.appendChild(seatGridEl);
    }else{
      gridWrapEl.innerHTML=""; gridWrapEl.appendChild(deskBarEl); gridWrapEl.appendChild(seatGridEl);
    }

    var violations = currentViolations();
    var violatingIds = {};
    violations.forEach(function(p){ violatingIds[p[0]]=true; violatingIds[p[1]]=true; });

    for(var r=0;r<layout.rows;r++){
      for(var c=0;c<layout.cols;c++){
        var sid = seatId(r,c);
        var cell = document.createElement("div");
        if(isGap(r,c,layout)){
          cell.className = "seat gap";
          if(editModeToggle.checked){ cell.addEventListener("click", function(id){ return function(){ toggleGapCell(id); }; }(sid)); }
          seatGridEl.appendChild(cell); continue;
        }
        cell.className = "seat";
        cell.dataset.seat = sid;
        cell.addEventListener("dragover", function(e){ e.preventDefault(); e.currentTarget.classList.add("dragover"); });
        cell.addEventListener("dragleave", function(e){ e.currentTarget.classList.remove("dragover"); });
        cell.addEventListener("drop", function(id){ return function(e){
          e.preventDefault(); e.currentTarget.classList.remove("dragover");
          var sidv = draggingId || e.dataTransfer.getData("text/plain");
          if(sidv) moveStudent(sidv, id);
          draggingId=null;
        }; }(sid));

        if(editModeToggle.checked){
          cell.addEventListener("click", function(id){ return function(){ toggleGapCell(id); }; }(sid));
          var editOcc = cls.assignment[sid];
          if(editOcc){
            var editSt = studentById(editOcc);
            if(editSt){
              var lbl = document.createElement("span");
              lbl.style.fontSize = "11px"; lbl.style.color = "var(--ink-faint)";
              lbl.textContent = truncate(editSt.name, 6);
              cell.appendChild(lbl);
            }
          }
        }else{
          var occ = cls.assignment[sid];
          if(occ){
            var st = studentById(occ);
            if(st){
              var tag = document.createElement("div");
              tag.className = "seat-tag" + (pickedStudentId===occ ? " picked":"") + (violatingIds[occ] ? " violation":"");
              tag.draggable = true;
              tag.addEventListener("dragstart", function(id){ return function(e){ draggingId=id; e.dataTransfer.setData("text/plain", id); }; }(occ));
              tag.addEventListener("click", function(id){ return function(e){ e.stopPropagation(); onTagClick(id); }; }(occ));

              var nm = document.createElement("div"); nm.className="nm"; nm.textContent = truncate(st.name,8);
              tag.appendChild(nm);
              var badges = document.createElement("div"); badges.className="badges";
              if(st.needsFront) badges.appendChild(document.createTextNode(NEED_ICON.front));
              if(st.needsBack) badges.appendChild(document.createTextNode(NEED_ICON.back));
              if(st.needsAisle) badges.appendChild(document.createTextNode(NEED_ICON.aisle));
              tag.appendChild(badges);

              var pin = document.createElement("button"); pin.className="pin"+(st.fixedSeatId===sid?" on":"");
              pin.textContent="📌"; pin.title="이 자리에 고정";
              pin.addEventListener("click", function(s, id){ return function(e){
                e.stopPropagation();
                s.fixedSeatId = (s.fixedSeatId===id) ? null : id;
                persist(); renderGrid();
              }; }(st, sid));
              tag.appendChild(pin);

              cell.appendChild(tag);
            }
          }else{
            cell.addEventListener("click", function(id){ return function(){ onEmptySeatClick(id); }; }(sid));
            var num = document.createElement("span"); num.className="seat-num"; num.textContent="+";
            cell.appendChild(num);
          }
        }
        seatGridEl.appendChild(cell);
      }
    }

    if(violations.length>0){
      var names = violations.map(function(p){ return studentById(p[0]).name+"-"+studentById(p[1]).name; }).join(", ");
      toolbarStatus.textContent = "⚠ 강한 규칙 위반 " + violations.length + "건: " + names;
      toolbarStatus.classList.add("warn");
    }else{
      toolbarStatus.textContent = "규칙 위반 없음";
      toolbarStatus.classList.remove("warn");
    }
  }

  function renderTray(){
    var cls = currentClass();
    var seated = {};
    Object.keys(cls.assignment).forEach(function(k){ seated[cls.assignment[k]] = true; });
    var unseated = cls.students.filter(function(s){ return !seated[s.id]; });
    unseatedTrayEl.innerHTML = "";
    if(unseated.length===0){
      var p = document.createElement("span"); p.className="tray-empty"; p.textContent="모든 학생이 배치되었어요";
      unseatedTrayEl.appendChild(p); return;
    }
    unseated.forEach(function(s){
      var tag = document.createElement("div");
      tag.className = "tray-tag" + (pickedStudentId===s.id ? " picked":"");
      tag.draggable = true;
      tag.addEventListener("dragstart", function(id){ return function(e){ draggingId=id; e.dataTransfer.setData("text/plain", id); }; }(s.id));
      tag.addEventListener("click", function(id){ return function(e){ e.stopPropagation(); onTagClick(id); }; }(s.id));
      tag.appendChild(document.createTextNode(s.name));
      var badges = document.createElement("span"); badges.className="badges";
      if(s.needsFront) badges.appendChild(document.createTextNode(NEED_ICON.front));
      if(s.needsBack) badges.appendChild(document.createTextNode(NEED_ICON.back));
      if(s.needsAisle) badges.appendChild(document.createTextNode(NEED_ICON.aisle));
      tag.appendChild(badges);
      unseatedTrayEl.appendChild(tag);
    });
  }

  /* ---------- auto arrange ---------- */
  function computeFairnessMap(cls){
    var map = {};
    var recent = cls.history.slice(0,2);
    if(recent.length===0) return map;
    var sums = {}, counts = {};
    recent.forEach(function(entry){
      var layout = entry.layout || cls.layout;
      var maxFd = maxFrontDistance(layout);
      Object.keys(entry.assignment).forEach(function(sid){
        var studentId = entry.assignment[sid];
        var parts = sid.split("_"); var r=+parts[0], c=+parts[1];
        var fd = frontDistance(r,c,layout) / maxFd;
        sums[studentId] = (sums[studentId]||0) + fd;
        counts[studentId] = (counts[studentId]||0) + 1;
      });
    });
    Object.keys(sums).forEach(function(id){ map[id] = sums[id]/counts[id]; });
    return map;
  }
  function computeLastNeighborSet(cls){
    var set = {};
    if(cls.history.length===0) return set;
    var last = cls.history[0];
    var pairs = adjacencyPairs(last.assignment, last.layout || cls.layout);
    pairs.forEach(function(p){ set[pairKey(p[0],p[1])] = true; });
    return set;
  }

  function scoreAssignment(assignment, cls, fairnessMap, lastNeighborSet){
    var layout = cls.layout;
    var hardSet = {}, softSet = {};
    cls.hardRules.forEach(function(r){ hardSet[pairKey(r.a,r.b)]=true; });
    cls.softRules.forEach(function(r){ softSet[pairKey(r.a,r.b)]=true; });
    var pairs = adjacencyPairs(assignment, layout);
    var violations = 0, score = 0;
    pairs.forEach(function(p){
      var k = pairKey(p[0],p[1]);
      if(hardSet[k]){ violations++; score -= 1000; }
      if(softSet[k]){ score += 15; }
      if(lastNeighborSet[k]){ score -= 5; }
    });
    var maxFd = maxFrontDistance(layout);
    Object.keys(assignment).forEach(function(sid){
      var studentId = assignment[sid];
      var st = studentById(studentId);
      if(!st) return;
      var parts = sid.split("_"); var r=+parts[0], c=+parts[1];
      var fd = frontDistance(r,c,layout);
      if(st.needsFront) score -= fd*3;
      if(st.needsBack) score -= (maxFd-fd)*3;
      if(st.needsAisle && !isAisleAdjacent(r,c,layout)) score -= 40;
      var fair = fairnessMap[studentId] || 0;
      score -= fair * fd * 2;
    });
    return { score:score, violations:violations };
  }

  function shuffle(arr){
    var a = arr.slice();
    for(var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=a[i]; a[i]=a[j]; a[j]=t; }
    return a;
  }

  function buildRandomCandidate(cls){
    var layout = cls.layout;
    var allSeats = activeSeatIds(layout);
    var assignment = {};
    var fixedStudentIds = {};
    cls.students.forEach(function(s){
      if(s.fixedSeatId && allSeats.indexOf(s.fixedSeatId)>-1){
        assignment[s.fixedSeatId] = s.id;
        fixedStudentIds[s.id] = true;
      }
    });
    var remainingSeats = shuffle(allSeats.filter(function(sid){ return !assignment[sid]; }));
    var remainingStudents = shuffle(cls.students.filter(function(s){ return !fixedStudentIds[s.id]; }).map(function(s){ return s.id; }));
    var n = Math.min(remainingSeats.length, remainingStudents.length);
    for(var i=0;i<n;i++){ assignment[remainingSeats[i]] = remainingStudents[i]; }
    return assignment;
  }

  autoArrangeBtn.addEventListener("click", function(){
    var cls = currentClass();
    if(cls.students.length===0){ toolbarStatus.textContent="먼저 학생을 추가해주세요"; return; }
    var fairnessMap = computeFairnessMap(cls);
    var lastNeighborSet = computeLastNeighborSet(cls);
    var best = null, bestScore = -Infinity, bestViolations = Infinity;
    var iterations = 400;
    for(var i=0;i<iterations;i++){
      var candidate = buildRandomCandidate(cls);
      var result = scoreAssignment(candidate, cls, fairnessMap, lastNeighborSet);
      if(result.violations < bestViolations || (result.violations===bestViolations && result.score>bestScore)){
        bestViolations = result.violations; bestScore = result.score; best = candidate;
      }
    }
    if(best){ cls.assignment = best; markNotSample(); persist(); renderGrid(); renderTray(); }
  });

  /* ---------- confirm & history ---------- */
  confirmBtn.addEventListener("click", function(){
    var cls = currentClass();
    if(Object.keys(cls.assignment).length===0){ toolbarStatus.textContent="배치된 학생이 없어요"; return; }
    var entry = {
      id: genId("h"),
      date: new Date().toISOString(),
      assignment: JSON.parse(JSON.stringify(cls.assignment)),
      layout: JSON.parse(JSON.stringify(cls.layout))
    };
    cls.history.unshift(entry);
    persist(); renderHistory();
    toolbarStatus.textContent = "확정되었어요";
    toolbarStatus.classList.remove("warn");
  });

  function formatDate(iso){
    var d = new Date(iso);
    var mm = ("0"+(d.getMonth()+1)).slice(-2), dd=("0"+d.getDate()).slice(-2);
    var hh = ("0"+d.getHours()).slice(-2), mi=("0"+d.getMinutes()).slice(-2);
    return d.getFullYear()+"."+mm+"."+dd+" "+hh+":"+mi;
  }

  function renderHistory(){
    var cls = currentClass();
    historyListEl.innerHTML = "";
    if(cls.history.length===0){
      var p = document.createElement("p"); p.className="history-empty"; p.textContent="아직 확정된 배치가 없어요";
      historyListEl.appendChild(p); return;
    }
    cls.history.forEach(function(entry, idx){
      var item = document.createElement("div"); item.className="history-item";
      var meta = document.createElement("span"); meta.className="meta";
      meta.textContent = "#" + (cls.history.length-idx) + " · " + formatDate(entry.date);
      var acts = document.createElement("div"); acts.className="acts";
      var viewBtn = document.createElement("button"); viewBtn.textContent="불러오기";
      viewBtn.addEventListener("click", function(){
        cls.assignment = JSON.parse(JSON.stringify(entry.assignment));
        cls.layout = JSON.parse(JSON.stringify(entry.layout));
        persist(); renderGrid(); renderTray();
        toolbarStatus.textContent = "기록 #" + (cls.history.length-idx) + " 을 불러왔어요";
      });
      var delBtn = document.createElement("button"); delBtn.className="del"; delBtn.textContent="삭제";
      delBtn.addEventListener("click", function(){
        cls.history.splice(idx,1); persist(); renderHistory();
      });
      acts.appendChild(viewBtn); acts.appendChild(delBtn);
      item.appendChild(meta); item.appendChild(acts);
      historyListEl.appendChild(item);
    });
  }

  /* ---------- master render ---------- */
  function renderAll(){
    var cls = currentClass();
    sampleNote.style.display = cls.isSample ? "" : "none";
    rowsInput.value = cls.layout.rows;
    colsInput.value = cls.layout.cols;
    deskPosBtns.forEach(function(b){ b.classList.toggle("active", b.dataset.pos===cls.layout.deskPos); });
    renderClassTabs();
    renderStudentList();
    refreshRuleSelects();
    renderRuleLists();
    renderGrid();
    renderTray();
    renderHistory();
  }

  editModeToggle.addEventListener("change", renderGrid);

  renderAll();
})();
</script>
