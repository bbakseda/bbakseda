
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI 이미지 프롬프트 빌더 (초대형 확장판)</title>
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --accent: #38bdf8;
      --accent-hover: #0ea5e9;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --border: #334155;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: var(--bg); color: var(--text); display: flex; justify-content: center; padding: 40px 20px; }
    .container { width: 100%; max-width: 820px; background: var(--card-bg); border-radius: 14px; padding: 32px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); border: 1px solid var(--border); }
    h1 { font-size: 1.6rem; margin-bottom: 8px; color: var(--accent); }
    p.desc { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 24px; }
    
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 24px; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field.full { grid-column: span 2; }
    label { font-size: 0.85rem; font-weight: 600; color: var(--text-muted); }
    
    select, input, textarea {
      width: 100%; padding: 11px 12px; background: #0f172a; border: 1px solid var(--border);
      border-radius: 8px; color: var(--text); font-size: 0.9rem; outline: none; transition: border-color 0.2s;
    }
    select:focus, input:focus, textarea:focus { border-color: var(--accent); }
    optgroup { background: #1e293b; color: var(--accent); font-weight: 700; }
    option { background: #0f172a; color: var(--text); font-weight: 400; }

    .result-section { border-top: 1px solid var(--border); padding-top: 20px; }
    textarea { height: 100px; resize: none; margin-bottom: 12px; line-height: 1.45; }
    
    .btn-group { display: flex; gap: 10px; }
    button {
      flex: 1; padding: 12px; border: none; border-radius: 8px; font-size: 0.95rem; font-weight: 600;
      cursor: pointer; transition: background 0.2s, transform 0.1s;
    }
    .btn-copy { background: var(--accent); color: #0f172a; }
    .btn-copy:hover { background: var(--accent-hover); }
    .btn-copy:active { transform: scale(0.98); }
    .btn-reset { background: #334155; color: var(--text); }
    .btn-reset:hover { background: #475569; }

    .toast {
      display: none; margin-top: 10px; text-align: center; font-size: 0.85rem; color: #4ade80;
    }
  </style>
</head>
<body>

<div class="container">
  <h1>AI Image Prompt Builder</h1>
  <p class="desc">각 옵션을 조합하고 필요한 키워드를 입력해 완성도 높은 단일 프롬프트를 만드세요.</p>

  <div class="grid">
    <div class="field full">
      <label>1. 주제 및 동작 (Subject)</label>
      <input type="text" id="subject" placeholder="예: a sleek futuristic robot cat playing with glowing yarn" oninput="generatePrompt()">
    </div>

    <!-- 2. 아트 스타일 -->
    <div class="field full">
      <label>2. 아트 스타일 (Art Style)</label>
      <select id="style" onchange="generatePrompt()">
        <option value="">선택 안 함 (None)</option>
        <optgroup label="📷 실사 / 사진 (Photorealistic & Camera)">
          <option value="photorealistic, editorial photography, 35mm lens, sharp details">매거진 화보 (Editorial Photo)</option>
          <option value="National Geographic documentary photography, raw capture">다큐멘터리/내셔널지오그래픽 (National Geographic)</option>
          <option value="cinematic still shot, 70mm IMAX film, Panavision lens">영화 스틸컷 (Cinematic Movie Still)</option>
          <option value="polaroid snapshot, vintage 90s grain, nostalgic flash">폴라로이드 필름 (Vintage Polaroid)</option>
          <option value="macro close-up photography, extreme detail, depth of field">초근접 매크로 촬영 (Macro Photography)</option>
        </optgroup>
        <optgroup label="🎨 디지털 일러스트 / 애니메이션 (Digital Art & Anime)">
          <option value="vibrant modern digital illustration, artstation trending">모던 디지털 아트 (ArtStation Trending)</option>
          <option value="Studio Ghibli aesthetic, anime background art, hand-painted feel">스튜디오 지브리 감성 (Studio Ghibli)</option>
          <option value="Makoto Shinkai style, breathtaking sky, hyper-detailed anime aesthetic">신카이 마코토 감성 풍경 (Makoto Shinkai)</option>
          <option value="cyberpunk anime style, vivid neon hues, detailed linework">사이버펑크 애니메이션 (Cyberpunk Anime)</option>
          <option value="minimalist flat vector illustration, clean lines, corporate memo">플랫 벡터 일러스트 (Flat Vector)</option>
          <option value="children's storybook illustration, whimsical, soft fairy tale art">동화책 감성 일러스트 (Whimsical Storybook)</option>
        </optgroup>
        <optgroup label="🧊 3D 그래픽 / 입체 (3D Render & CGI)">
          <option value="octane render, unreal engine 5, ray tracing, ultra realistic CGI">하이엔드 3D 렌더 (Octane / UE5)</option>
          <option value="Pixar 3D animation style, cute character design, soft lighting">픽사 3D 애니메이션 (Pixar / Disney 3D)</option>
          <option value="isometric 3D diorama, tilt-shift lens, blender 3D">아이소메트릭 디오라마 (Isometric 3D)</option>
          <option value="claymation style, handcrafted plasticine texture, stop motion look">클레이메이션 / 점토 공예 (Claymation)</option>
          <option value="paper craft art, origami layers, delicate shadow cutouts">페이퍼 아트 / 종이 공예 (Paper Cutout)</option>
        </optgroup>
        <optgroup label="🖌️ 순수 미술 / 회화 (Fine Arts & Painting)">
          <option value="oil painting on textured canvas, heavy impasto, visible brushstrokes">유화 / 임파스토 (Textured Oil Painting)</option>
          <option value="soft watercolor splash, fluid ink bleeds, pastel wash on paper">수채화 (Watercolor Splash)</option>
          <option value="detailed ink sketch, cross-hatching, vintage pen drawing">펜 드로잉 / 에칭 (Detailed Ink Sketch)</option>
          <option value="charcoal sketch on rough parchment, dramatic smudges, monochrome">목탄화 (Charcoal Drawing)</option>
          <option value="traditional Korean sumi-e ink wash painting, graceful brush technique">수묵화 / 동양화 (Sumi-e Ink Wash)</option>
        </optgroup>
        <optgroup label="👾 레트로 / 서브컬처 (Retro & Fantasy)">
          <option value="vintage American comic book art, pop art halftone dots, retro ink">빈티지 미국 만화 (Retro Comic / Pop Art)</option>
          <option value="16-bit pixel art, retro video game aesthetic, sharp pixels">16비트 레트로 픽셀 아트 (Pixel Art)</option>
          <option value="dark fantasy, intricate gothic illustration, moody Elden Ring vibe">다크 판타지 / 고딕 (Dark Fantasy)</option>
          <option value="synthwave aesthetic, 80s retro-futurism, glowing wireframe grid">신스웨이브 80년대 레트로 (Synthwave)</option>
        </optgroup>
      </select>
    </div>

    <!-- 3. 환경 및 배경 (대폭 확장) -->
    <div class="field">
      <label>3. 환경 및 배경 (Environment)</label>
      <select id="environment" onchange="generatePrompt()">
        <option value="">선택 안 함 (None)</option>

        <optgroup label="🌲 자연 및 야외 (Nature & Landscapes)">
          <option value="in a mystical ancient forest filled with glowing fireflies and moss">신비로운 고대 원시림</option>
          <option value="on an epic fantasy snow mountain peak under dramatic storm clouds">웅장한 설산 정상</option>
          <option value="along a peaceful sunlit coastal road overlooking vast ocean waves">탁 트인 바다 해안 도로</option>
          <option value="in an endless sand dune desert with rippling heatwaves">광활한 사막 모래 언덕</option>
          <option value="in a tranquil blooming cherry blossom garden with falling petals">벚꽃 흩날리는 정원</option>
          <option value="underwater ocean reef surrounded by vibrant coral and marine life">산호초가 가득한 바닷속</option>
        </optgroup>

        <optgroup label="🏙️ 현대 및 도시 (Urban & Architecture)">
          <option value="in a bustling modern city downtown crosswalk, high-rise glass buildings">분주한 현대 도심 사거리</option>
          <option value="in a cozy quiet narrow European alleyway with cobblestone streets">유럽풍 조용한 돌길 골목</option>
          <option value="on a high rooftop overlooking sprawling cityscape at twilight">도심 노을을 내려다보는 옥상</option>
          <option value="at a bustling vibrant night street market with food stalls and lanterns">활기찬 야시장 골목</option>
        </optgroup>

        <optgroup label="🚀 SF / 판타지 / 비현실 (Sci-Fi & Surreal)">
          <option value="in a futuristic neon-lit cyberpunk metropolis street with flying vehicles">사이버펑크 미래 도시</option>
          <option value="inside a high-tech orbital space station viewing Earth from orbit">우주 정거장 내부 전망창</option>
          <option value="on a floating sky island with waterfalls falling into clouds">구름 위의 공중 부유섬</option>
          <option value="inside ancient crumbling gothic ruins overgrown with glowing flora">발광 식물로 뒤덮인 고대 유적</option>
          <option value="surreal dreamscape with distorted gravity and giant floating planets">왜곡된 중력의 초현실 공간</option>
        </optgroup>

        <optgroup label="🏠 실내 / 스튜디오 (Indoor & Studio)">
          <option value="in a warm cozy sunlit library with vintage wooden desks and books">아늑하고 클래식한 서재</option>
          <option value="in a modern clean science laboratory with glassware and holograms">최첨단 과학 실험실</option>
          <option value="in a warm cafe interior with morning sunlight through glass window">햇살 드는 아침 카페 실내</option>
          <option value="in a minimalist empty seamless white photo studio backdrop">미니멀 화이트 스튜디오</option>
          <option value="in a dark moody concrete studio with subtle background fog">다크 모던 콘크리트 스튜디오</option>
        </optgroup>
      </select>
    </div>

    <!-- 4. 조명 및 분위기 (대폭 확장) -->
    <div class="field">
      <label>4. 조명 및 분위기 (Lighting & Mood)</label>
      <select id="lighting" onchange="generatePrompt()">
        <option value="">선택 안 함 (None)</option>

        <optgroup label="☀️ 자연광 (Natural Light)">
          <option value="cinematic golden hour sunlight, long warm shadows, lens flare">골든 아워 (따뜻한 황금빛 노을)</option>
          <option value="bright vivid morning sunlight, fresh crisp atmospheric glow">상쾌하고 맑은 아침 햇살</option>
          <option value="blue hour twilight, deep moody indigo ambient tones">블루 아워 (새벽/해질녘 푸른빛)</option>
          <option value="dappled sunlight filtering through tree leaves, soft shadows">나뭇잎 사이로 부서지는 햇살</option>
          <option value="overcast diffused cloudy daylight, soft neutral tones">흐린 날의 부드러운 산란광</option>
        </optgroup>

        <optgroup label="🎬 시네마틱 / 특수 조명 (Cinematic & Dramatic)">
          <option value="dramatic volumetric lighting, visible god rays breaking through fog">입체 광선 (빛내림 / 틴들 효과)</option>
          <option value="dramatic low-key lighting, heavy chiaroscuro shadow contrasts">다크 로우키 (강렬한 명암 대비)</option>
          <option value="strong cinematic rim lighting, glowing silhouette edges">윤곽선을 강조하는 림라이트</option>
          <option value="candlelight and flickering fire glow, warm intimate shadows">따스하게 흔들리는 촛불/모닥불</option>
          <option value="ominous stormy lightning flash, high tension atmosphere">번개 섬광과 폭풍우 분위기</option>
        </optgroup>

        <optgroup label="💡 인공광 / 네온 (Artificial & Neon)">
          <option value="moody dual-tone neon lighting, cyan and magenta contrast">사이버 네온 (시안 & 마젠타 듀얼톤)</option>
          <option value="soft diffused commercial studio lighting, balanced clean fill">광고용 소프트 스튜디오 조명</option>
          <option value="hard direct camera flash photography, sharp retro shadows">직광 플래시 (레트로 스냅샷)</option>
          <option value="bioluminescent ethereal glow, glowing ambient particles">자체 발광 유기체 (신비로운 형광빛)</option>
        </optgroup>
      </select>
    </div>

    <!-- 5. 구도 및 앵글 (대폭 확장) -->
    <div class="field">
      <label>5. 구도 및 앵글 (Composition & Camera)</label>
      <select id="composition" onchange="generatePrompt()">
        <option value="">선택 안 함 (None)</option>

        <optgroup label="📐 카메라 앵글 / 시점 (Angles & Perspective)">
          <option value="dynamic low angle shot, heroic empowering perspective">로우 앵글 (웅장하고 역동적인 시점)</option>
          <option value="high angle bird's-eye view, dramatic overhead lookdown">하이 앵글 (위에서 내려다보는 시점)</option>
          <option value="perfectly eye-level shot, natural straightforward view">아이 레벨 (자연스러운 눈높이 시점)</option>
          <option value="straight top-down flat lay view, knolling arrangement">탑다운 버드아이 (수직 부감 / 플랫레이)</option>
          <option value="Dutch angle, tilted dramatic camera horizon, high tension">더치 앵글 (긴장감 있는 사선 기울기)</option>
          <option value="first-person POV perspective, immersive subjective angle">1인칭 시점 (POV 몰입형 앵글)</option>
        </optgroup>

        <optgroup label="🔍 화각 / 피사체 프레이밍 (Framing & Shot Size)">
          <option value="cinematic ultra wide-angle landscape shot, vast scenery">초광각 풍경 샷 (웅장한 공간감)</option>
          <option value="full body shot, centered subject framing, clean proportions">전신 샷 (안정적인 중앙 배치)</option>
          <option value="cowboy shot, framed from mid-thigh up, western style framing">카우보이 샷 (무릎/허벅지 상단 프레이밍)</option>
          <option value="intimate medium close-up portrait, focusing on expressions">인물 바스트 / 클로즈업</option>
          <option value="extreme macro close-up shot, microscopic intricate textures">초접사 매크로 샷 (질감 극대화)</option>
        </optgroup>

        <optgroup label="🎯 특수 포커스 / 배치 (Focus & Composition Rules)">
          <option value="shallow depth of field, sharp subject focus with creamy background bokeh">얕은 심도 (강한 배경 흐림/보케)</option>
          <option value="deep focus, crisp clarity across entire scene from foreground to background">딥 포커스 (전체 영역 핀포커스)</option>
          <option value="rule of thirds framing, balanced negative space aesthetic">3분할 구도 (여백의 미 강조)</option>
          <option value="miniature tilt-shift photography, diorama miniature effect">틸트 시프트 (미니어처 효과)</option>
        </optgroup>
      </select>
    </div>

    <!-- 6. 화면 비율 (대폭 확장) -->
    <div class="field">
      <label>6. 화면 비율 (Aspect Ratio)</label>
      <select id="aspectRatio" onchange="generatePrompt()">
        <option value="">기본 정방형 (1:1)</option>

        <optgroup label="🖥️ 가로형 와이드 (Landscape & Screen)">
          <option value="--ar 16:9">와이드스크린 기본 (--ar 16:9, 유튜브/PC)</option>
          <option value="--ar 21:9">울트라 와이드 시네마스코프 (--ar 21:9, 영화관 비율)</option>
          <option value="--ar 4:3">클래식 브라운관 모니터 (--ar 4:3)</option>
          <option value="--ar 3:2">35mm DSLR 기본 포토 (--ar 3:2)</option>
        </optgroup>

        <optgroup label="📱 세로형 포트레이트 (Portrait & Mobile)">
          <option value="--ar 9:16">스마트폰 풀화면 세로 (--ar 9:16, 릴스/쇼츠/스토리)</option>
          <option value="--ar 4:5">인스타그램 세로 피드 최적화 (--ar 4:5)</option>
          <option value="--ar 2:3">클래식 세로 사진/화보 (--ar 2:3)</option>
          <option value="--ar 3:4">태블릿/아이패드 세로 규격 (--ar 3:4)</option>
        </optgroup>

        <optgroup label="🖼️ 파노라마 / 특수 (Panorama & Custom)">
          <option value="--ar 32:9">듀얼 모니터 슈퍼 울트라와이드 (--ar 32:9)</option>
          <option value="--ar 1:2">롱 포스터 세로형 배너 (--ar 1:2)</option>
        </optgroup>
      </select>
    </div>

    <div class="field full">
      <label>7. 사용자 임의 입력 (추가 디테일/키워드)</label>
      <input type="text" id="custom" placeholder="예: bioluminescent glow, floating micro dust particles, intricate metallic texture" oninput="generatePrompt()">
    </div>
  </div>

  <div class="result-section">
    <label>완성된 프롬프트 (One-line Prompt)</label>
    <textarea id="output" readonly></textarea>
    <div class="btn-group">
      <button class="btn-copy" onclick="copyPrompt()">프롬프트 복사하기</button>
      <button class="btn-reset" onclick="resetForm()">초기화</button>
    </div>
    <div id="toast" class="toast">클립보드에 복사되었습니다!</div>
  </div>
</div>

<script>
  function generatePrompt() {
    const subject = document.getElementById('subject').value.trim();
    const style = document.getElementById('style').value;
    const environment = document.getElementById('environment').value;
    const lighting = document.getElementById('lighting').value;
    const composition = document.getElementById('composition').value;
    const custom = document.getElementById('custom').value.trim();
    const ar = document.getElementById('aspectRatio').value;

    const parts = [subject, style, environment, lighting, composition, custom].filter(part => part !== "");
    
    let promptString = "";
    if (parts.length > 0) {
      parts.push("8k resolution, highly detailed, masterwork");
      promptString = parts.join(', ');
      
      if (ar) {
        promptString += ` ${ar}`;
      }
    }

    document.getElementById('output').value = promptString;
  }

  function copyPrompt() {
    const output = document.getElementById('output');
    if (!output.value) return;

    navigator.clipboard.writeText(output.value).then(() => {
      const toast = document.getElementById('toast');
      toast.style.display = 'block';
      setTimeout(() => { toast.style.display = 'none'; }, 2000);
    });
  }

  function resetForm() {
    document.getElementById('subject').value = '';
    document.getElementById('style').selectedIndex = 0;
    document.getElementById('environment').selectedIndex = 0;
    document.getElementById('lighting').selectedIndex = 0;
    document.getElementById('composition').selectedIndex = 0;
    document.getElementById('aspectRatio').selectedIndex = 0;
    document.getElementById('custom').value = '';
    document.getElementById('output').value = '';
  }
</script>

</body>
</html>
